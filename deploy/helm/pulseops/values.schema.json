{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "config", "security"],
  "properties": {
    "existingSecret": {"type": "string", "minLength": 1},
    "config": {
      "type": "object",
      "required": ["databaseUrl", "kafkaBrokers", "otlpEndpoint", "grafanaUrl"],
      "properties": {
        "databaseUrl": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "kafkaBrokers": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "otlpEndpoint": {"type": "string", "minLength": 1},
        "grafanaUrl": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["imageRegistry", "imageTag"],
      "properties": {
        "imageRegistry": {"type": "string", "minLength": 1},
        "imageTag": {"type": "string", "minLength": 1}
      }
    },
    "security": {
      "type": "object",
      "required": ["issuerUri", "audience", "dashboardClientId", "dashboardPublicUrl", "bootstrapIssuer", "bootstrapSubject"],
      "properties": {
        "issuerUri": {
          "type": "string",
          "pattern": "^https://",
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "audience": {"type": "string", "minLength": 1},
        "dashboardClientId": {"type": "string", "minLength": 1},
        "dashboardPublicUrl": {
          "type": "string",
          "pattern": "^https://",
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "bootstrapIssuer": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "bootstrapSubject": {"type": "string", "minLength": 1}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
