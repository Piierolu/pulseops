{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "config"],
  "properties": {
    "existingSecret": {"type": "string", "minLength": 1},
    "config": {
      "type": "object",
      "required": ["databaseUrl", "kafkaBrokers", "otlpEndpoint", "grafanaUrl"],
      "properties": {
        "databaseUrl": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "kafkaBrokers": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        },
        "otlpEndpoint": {"type": "string", "minLength": 1},
        "grafanaUrl": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "\\.example(\\.|:|/|$)"}
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["imageRegistry", "imageTag"],
      "properties": {
        "imageRegistry": {"type": "string", "minLength": 1},
        "imageTag": {"type": "string", "minLength": 1}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "externalAuthentication": {"type": "boolean"},
        "allowPublicReadOnly": {"type": "boolean"}
      }
    }
  }
}
